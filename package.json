{
  "name": "signal-pipeline-template",
  "version": "0.1.0",
  "description": "Signal-to-CRM pipeline template: webhook intake → normalize → enrich → score → push (Supabase + Trigger.dev)",
  "type": "module",
  "scripts": {
    "dev": "trigger dev",
    "build": "tsc",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:gen-types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test": "vitest",
    "test:scoring": "vitest run src/scoring",
    "audit:hubspot-schema": "tsx scripts/hubspot-schema-audit.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hubspot/api-client": "^12.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "@trigger.dev/sdk": "^4.4.4",
    "googleapis": "^171.4.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.4.4",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "xlsx": "^0.18.5"
  }
}
